version: '3'

networks:
  nw:
    driver: bridge
  nw2:
    driver: bridge

services:
  redis:
    container_name: redis_cont
    image: redis:latest
    restart: always
    ports:
      - "6379:6379"
    volumes:
      - /path/to/local/dаta:/root/redis
      - /path/to/local/redis.conf:/usr/local/etc/redis/redis.conf
    networks:
      - nw2
    environment:
      - REDIS_PASSWORD=my-password
      - REDIS_PORT=6379
      - REDIS_DATABASES=16
    
  user:
    container_name: user
    build:
      context: ./user
      dockerfile: DockerfileUser
    volumes:
      - ./user:/app
    ports:
      - "8080:8080"
      - "5678:5678"  # Add this line for debugging port
    networks:
      - nw
    depends_on:
      user_db:
        condition: service_healthy
    env_file:
      - ./user/.env
    command: ["python", "manage.py", "runserver", "0.0.0.0:8080"]

  user_db:
    container_name: user_db
    build:
      context: ./user
      dockerfile: DockerfileDb
    volumes:
      - ./user/init_db.sql:/docker-entrypoint-initdb.d/init_db.sql
      - user_data:/var/lib/postgresql/data
    ports:
      - "5433:5432"
    networks:
      - nw
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 3s
      timeout: 3s
      retries: 3

  pinpong:
    container_name: pingpong
    build:
      context: ./pingpong
      dockerfile: DockerfilePingPong
    volumes:
      - ./pingpong:/app
    ports:
      - "8081:8081"
    networks:
      - nw2
    depends_on:
      pingpong_db:
        condition: service_healthy

  pingpong_db:
    container_name: pingpong_db
    build:
      context: ./pingpong
      dockerfile: DockerfileDb
    volumes:
      - ./pingpong/init_db.sql:/docker-entrypoint-initdb.d/init_db.sql
      - pingpong_data:/var/lib/postgresql/data
    ports:
      - "5434:5432"
    networks:
      - nw2
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 3s
      timeout: 5s
      retries: 3

  nginx:
    container_name: frontendbi
    build: ./frontend
    ports:
      - "8082:8082"
    volumes:
      - ./frontend/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./frontend:/usr/share/nginx/html/
    networks:
      - nw

volumes:
  user_data:
  pingpong_data:


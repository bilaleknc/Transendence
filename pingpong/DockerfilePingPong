# Base image olarak Python 3.9 slim sürümünü kullan
FROM python:3.9-slim

# Ortam değişkenlerini ayarla
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
ENV DJANGO_SETTINGS_MODULE=pingpong.settings


# Çalışma dizinini oluştur
WORKDIR /app

# Bağımlılıkları kur
COPY certs/certificate.crt /etc/ssl/certs/certificate.crt
COPY certs/certificate.key /etc/ssl/private/certificate.key
COPY requirements.txt .

RUN apt-get update && apt-get install -y postgresql-client
RUN pip install --upgrade pip && \
    pip install -r requirements.txt 
# --no-cache-dir

COPY . .

# Veritabanı migrasyonlarını yap
# RUN python3 manage.py makemigrations

# environment variables file
# COPY .env .

# RUN python3 manage.py makemigrations

EXPOSE 8081

# Django uygulamasını başlatma komutu
# CMD python3 manage.py runsslserver 0.0.0.0:8081
CMD daphne -e ssl:8081:privateKey=/etc/ssl/private/certificate.key:certKey=/etc/ssl/certs/certificate.crt pingpong.asgi:application
